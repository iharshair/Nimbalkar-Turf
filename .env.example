# ─────────────────────────────────────────────────────────────
# Nimbalkar Sports Club — environment
# Browser-visible values MUST use the NEXT_PUBLIC_ prefix — Next.js
# only inlines those into the client bundle. A VITE_ prefix (or any
# other) reads as undefined at runtime.
#
# Copy to `.env.local` and fill in. Nothing here is required to
# run the site locally: with no keys set the app boots in DEMO
# MODE (seeded slot grid + simulated payment) so you can review
# the full UX before wiring live credentials.
# ─────────────────────────────────────────────────────────────

# ── Firebase (client / public) ───────────────────────────────
# Optional while developing. Leave blank and availability is served from
# the local store via /api/slots/[date] instead of streamed from Firestore.
# REQUIRED before using live (rzp_live_*) Razorpay keys — the app refuses
# to take real money into non-durable local storage.
# Firebase console → Project settings → Your apps → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — enables Analytics. Absent, Analytics stays off.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin (SERVER ONLY — real secret) ────────────────
# Service account used by /api routes and scripts/seed.ts. This
# credential bypasses firestore.rules entirely — treat it like a
# root password, and never give it a NEXT_PUBLIC_ prefix.
#
# Firebase console → Project settings → Service accounts →
# Generate new private key. Only THREE fields from the downloaded
# JSON are needed: project_id, client_email and private_key. The
# rest are constants or unused by the Admin SDK.
#
# The key must stay on ONE line, double-quoted, with literal \n
# escapes preserved. That is the usual point of failure; if it's
# wrong, adminConfigProblem() will tell you exactly how.
#
# REQUIRED in production: a production build without these refuses
# bookings with a 503 rather than falling back to local storage.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Razorpay ─────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use rzp_test_* while building.
# These alone are enough to take (test) payments: with Firebase blank the
# app stores bookings in .data/store.json instead of Firestore.
# RAZORPAY_SECRET is accepted as an alias for RAZORPAY_KEY_SECRET.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_SECRET is accepted as an alias, since that's what the
# dashboard calls the field.
#RAZORPAY_SECRET=
# Dashboard → Settings → Webhooks (events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# ── Receipts (both optional; skipped with a log if unset) ─────
RESEND_API_KEY=
RECEIPT_FROM_EMAIL="Nimbalkar Sports Club <bookings@example.com>"
RECEIPT_BCC_EMAIL=
# MSG91 (or any transactional SMS provider) for SMS receipts
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Misc ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Force demo mode even when keys exist (useful for staging demos)
NEXT_PUBLIC_FORCE_DEMO_MODE=false
