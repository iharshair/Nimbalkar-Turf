# ─────────────────────────────────────────────────────────────
# Nimbalkar Sports Club — environment
# Copy to `.env.local` and fill in. Nothing here is required to
# run the site locally: with no keys set the app boots in DEMO
# MODE (seeded slot grid + simulated payment) so you can review
# the full UX before wiring live credentials.
# ─────────────────────────────────────────────────────────────

# ── Firebase (client / public) ───────────────────────────────
# Optional while developing. Leave blank and availability is served from
# the local store via /api/slots/[date] instead of streamed from Firestore.
# REQUIRED before using live (rzp_live_*) Razorpay keys — the app refuses
# to take real money into non-durable local storage.
# Firebase console → Project settings → Your apps → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server only) ─────────────────────────────
# Service account used by /api routes and scripts/seed.ts.
# Keep the private key on ONE line with literal \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Razorpay ─────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use rzp_test_* while building.
# These alone are enough to take (test) payments: with Firebase blank the
# app stores bookings in .data/store.json instead of Firestore.
# RAZORPAY_SECRET is accepted as an alias for RAZORPAY_KEY_SECRET.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks (events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# ── Receipts (both optional; skipped with a log if unset) ─────
RESEND_API_KEY=
RECEIPT_FROM_EMAIL="Nimbalkar Sports Club <bookings@example.com>"
RECEIPT_BCC_EMAIL=
# MSG91 (or any transactional SMS provider) for SMS receipts
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ── Misc ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Force demo mode even when keys exist (useful for staging demos)
NEXT_PUBLIC_FORCE_DEMO_MODE=false
